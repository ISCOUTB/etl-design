###################################################################
# Typechecking .env
###################################################################

# Database connection configuration
DATABASE_CONNECTION_HOST=localhost
DATABASE_CONNECTION_PORT=50050
DATABASE_MAX_RETRIES=5
DATABASE_RETRY_DELAY_SECONDS=1.0
DATABASE_BACKOFF_MULTIPLIER=2.0

# Minimal server configuration for health checks
MINIMAL_SERVER_HOST=0.0.0.0
MINIMAL_SERVER_PORT=8080
MINIMAL_SERVER_DEBUG=false

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_DELAY_SECONDS=1.0
RABBITMQ_BACKOFF_MULTIPLIER=2.0
RABBITMQ_THRESHOLD_SECONDS=60

# Worker configuration
MAX_WORKERS=4
WORKER_PREFETCH_COUNT=1

# Main API configuration
API_REQUEST_URL=/api/v1/events/task-completed
API_TIMEOUT_SECONDS=30

# Excel-Reader configuration
EXCEL_READER_HOST=localhost
EXCEL_READER_PORT=8001
EXCEL_READER_TIMEOUT_SECONDS=30

# Exchange and Queue Configuration
RABBITMQ_EXCHANGE=typechecking.exchange

# Queues for different message types
RABBITMQ_QUEUE_INSERTION=typechecking.insertion.queue
RABBITMQ_QUEUE_VALIDATIONS=typechecking.validations.queue
RABBITMQ_QUEUE_RESULTS=typechecking.results.queue

# Routing Keys (used for binding queues to the exchange)
RABBITMQ_ROUTING_KEY_INSERTION=insertion.*
RABBITMQ_ROUTING_KEY_VALIDATIONS=validation.*
RABBITMQ_ROUTING_KEY_RESULTS=results.*

# Routing Keys for Publishing (used by producers to send messages)
RABBITMQ_PUBLISHERS_ROUTING_KEY_INSERTION=insertion.request
RABBITMQ_PUBLISHERS_ROUTING_KEY_VALIDATIONS=validation.request
RABBITMQ_PUBLISHERS_ROUTING_KEY_RESULTS=results.publish

# Extra parameters for each queue
RABBITMQ_QUEUE_TYPE_INSERTION="quorum"
RABBITMQ_QUEUE_TYPE_VALIDATIONS="quorum"
RABBITMQ_QUEUE_TYPE_RESULTS="quorum"

OTEL_SERVICE_NAME=typechecking-server
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: override full traces endpoint directly
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
