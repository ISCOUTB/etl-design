###################################################################
# SQL-Builder .env
###################################################################

SQL_BUILDER_HOST=localhost
SQL_BUILDER_PORT=50054
SQL_BUILDER_DEBUG=false

ENABLE_PROMETHEUS_METRICS=false
PROMETHEUS_METRICS_PORT=9090

OTEL_SERVICE_NAME=sql-builder
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: override full traces endpoint directly
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Inbound trace context from gRPC metadata
SQL_TRACE_CONTEXT_ENABLED=true
SQL_TRACE_CONTEXT_LOG_HEADERS=false
