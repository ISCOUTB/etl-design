###################################################################
# Formula-Parser .env
###################################################################

FORMULA_PARSER_HOST=localhost
FORMULA_PARSER_PORT=50052
FORMULA_PARSER_DEBUG=false

OTEL_SERVICE_NAME=formula-parser
OTEL_SERVICE_VERSION="1.0.0"

# Endpoint will be mounted on $OTEL_EXPORTER_OTLP_ENDPOINT/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318",
OTEL_TRACE_CONTEXT_ENABLED=true|false
