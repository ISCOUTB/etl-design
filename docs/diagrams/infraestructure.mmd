flowchart TB
    classDef iac      fill:#1a1a2e,stroke:#7c4dff,stroke-width:2px,color:#fff
    classDef network  fill:#0f3460,stroke:#4fc3f7,stroke-width:2px,color:#fff
    classDef compute  fill:#1b4332,stroke:#52b788,stroke-width:2px,color:#fff
    classDef storage  fill:#3d2000,stroke:#f39c12,stroke-width:2px,color:#fff
    classDef security fill:#3b1f2b,stroke:#e74c3c,stroke-width:2px,color:#fff
    classDef ansible  fill:#2d1b69,stroke:#ab47bc,stroke-width:2px,color:#fff

    subgraph TF["Terraform"]
        direction TB

        subgraph TF_AWS["1. AWS Resources (module: swarm-cluster)"]
            direction LR
            subgraph NET["VPC Networking"]
                direction TB
                IGW["Internet Gateway"]:::network
                RT["Route Table + Public Subnet"]:::network
                SG["Security Group</br>(22, 80, 443, 2377, 7946, 4789)"]:::network
                IGW --> RT --> SG
            end
            subgraph EC2["EC2 Swarm Nodes (Ubuntu)"]
                direction LR
                Manager["Manager Nodes"]:::compute
                Worker["Worker Nodes"]:::compute
            end
            subgraph FS["EFS Shared Storage"]
                EFS["Elastic File System</br>(NFS on /mnt/shared)"]:::storage
            end
            subgraph IAM_["Security and IAM"]
                direction LR
                IAMp["IAM Instance Profile"]:::security
                SSM["AWS Systems Manager</br>(AmazonSSMManagedInstanceCore)"]:::security
                IAMp --> SSM
            end
            KeyPair["SSH Key Pair</br>(RSA 4096 — saved locally)"]:::security
            Inventory["Ansible Inventory</br>(auto-generated by Terraform)"]:::iac
        end

        SG --> Manager
        SG --> Worker
        Manager <-->|"Swarm gossip TCP/UDP 7946</br>Overlay VXLAN 4789"| Worker
        Manager & Worker --> EFS
        Manager & Worker --> IAMp
        Manager & Worker -.->|"attached"| KeyPair
        Manager & Worker -.->|"hosts file"| Inventory

        subgraph TF_ANSIBLE["2. Ansible Provisioning  (null_resource local-exec, sequential)"]
            direction LR
            A1["ansible/docker.yml</br>────────────────</br>Install Docker Engine</br>containerd + Compose</br>on ALL nodes"]:::ansible
            A2["ansible/mount_fs.yml</br>────────────────</br>Install nfs-common</br>Mount EFS on /mnt/shared</br>Create Traefik cert path"]:::ansible
            A3["ansible/swarm-init.yml</br>────────────────</br>docker swarm init</br>on managers[0]</br>Join remaining managers</br>Join all workers"]:::ansible
            A1 -->|"depends_on: docker"| A2
            A1 -->|"depends_on: docker"| A3
        end

        TF_AWS -->|"depends_on: module.swarm_cluster"| A1
        Inventory -->|"inventory file"| A1
        Inventory -->|"inventory file"| A2
        Inventory -->|"inventory file"| A3
    end
