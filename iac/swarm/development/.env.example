# =============================================================================
#  GLOBAL CONFIGURATION
# =============================================================================
GLOBAL_STACK_NAME=dev

# =============================================================================
# TRAEFIK CONFIGURATION
# =============================================================================

DOMAIN=localhost
GRAFANA_PASSWORD=admin_password

TRAEFIK_EXPOSE_API=true

# htpasswd -nb admin "admin_password"
# admin:$apr1$qz.30pj3$NC2GaVwiKCJ/oDszmT15Q1
TRAEFIK_USERNAME=admin
TRAEFIK_HASHED_PASSWORD='$apr1$qz.30pj3$NC2GaVwiKCJ/oDszmT15Q1'

# =============================================================================
# SCALER CONFIGURATION
# =============================================================================
SCALER_PROMETHEUS_URL=http://prometheus:9090
SCALER_CHECK_INTERVAL=60
SCALER_COOLDOWN_PERIOD=120
SCALER_METRIC_WINDOW_MULTIPLIER=3

# =============================================================================
# PARSERS CONFIGURATION
# =============================================================================

# ── Formula Parser ──
PARSERS_FORMULA_PARSER_HOST=localhost
PARSERS_FORMULA_PARSER_PORT=50052
PARSERS_DEBUG_FORMULA_PARSER=true

# ── DDL Generator ──
PARSERS_DDL_GENERATOR_HOST=localhost
PARSERS_DDL_GENERATOR_PORT=50053
PARSERS_DDL_GENERATOR_DEBUG=true

# ── SQL Builder ──
PARSERS_SQL_BUILDER_HOST=localhost
PARSERS_SQL_BUILDER_PORT=50054
PARSERS_SQL_BUILDER_DEBUG=true

# ── Excel Reader ──
PARSERS_EXCEL_READER_HOST=localhost
PARSERS_EXCEL_READER_PORT=8001
PARSERS_EXCEL_READER_DEBUG=true

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_DEFAULT_VHOST=/

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongopass
MONGO_AUTH_SOURCE=admin
MONGO_DB=etl_db
MONGO_SCHEMAS_COLLECTION=schemas
MONGO_TASKS_COLLECTION=tasks

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_DB=0
REDIS_PASSWORD=redispass

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password

# =============================================================================
# DATABASE SERVICE CONFIGURATION
# =============================================================================

# ── MongoDB Settings ──
MONGO_MAX_RETRIES=5
MONGO_RETRY_DELAY_SECONDS=0.5
MONGO_RETRY_BACKOFF_FACTOR=2.0

# ── Redis Settings ──
REDIS_EXPIRE_SECONDS=300
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_SECONDS=0.5
REDIS_RETRY_BACKOFF_FACTOR=2.0

# ── Connection Settings ──
DATABASE_CONNECTION_HOST=localhost
DATABASE_CONNECTION_PORT=50050
DATABASE_CONNECTION_DEBUG=false

# ── Task TTL Settings ──
TASK_TTL_PENDING_SECONDS=1800
TASK_TTL_PROCESSING_SECONDS=3600
TASK_TTL_COMPLETED_SECONDS=86400
TASK_TTL_PUBLISHED_SECONDS=43200
TASK_TTL_FAILED_SECONDS=43200

# ── Cache TTL Settings ──
USER_CACHE_TTL_SECONDS=900
USER_LIST_CACHE_TTL_SECONDS=300
SCHEMA_CACHE_TTL_SECONDS=21600
DEFAULT_TTL_SECONDS=1800

# =============================================================================
# TYPECHECKING SERVICE CONFIGURATION
# =============================================================================

# ── Server Settings ──
TYPECHECKING_MINIMAL_SERVER_PORT=8080

# ── RabbitMQ Retry Settings ──
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_DELAY_SECONDS=1.0
RABBITMQ_BACKOFF_MULTIPLIER=2.0
RABBITMQ_THRESHOLD_SECONDS=60.0

# ── Worker Settings ──
MAX_WORKERS=4
WORKER_PREFETCH_COUNT=1

# ── Database Retry Settings ──
DATABASE_MAX_RETRIES=5
DATABASE_RETRY_DELAY_SECONDS=1.0
DATABASE_BACKOFF_MULTIPLIER=2.0


# ── API ──
API_TIMEOUT_SECONDS=30

# ── Excel-Reader ──
EXCEL_READER_TIMEOUT_SECONDS=30

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000
SERVER_HOST=localhost
SERVER_PORT=8000
SERVER_DEBUG=false

# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=secret_key_with_at_least_32_characters_long
AUTH_SIGN=sign_for_generated_tokens

CREDENTIALS_SECRET_KEY=your_credentials_secret_key_here
CREDENTIALS_SIGN=your_credentials_sign_here

IDEMPOTENCY_TTL_DEFAULT_SECONDS=600
IDEMPOTENCY_TTL_RETRY_DELAY_SECONDS=60
IDEMPOTENCY_TTL_PUBLISHED_SECONDS=1800

FIRST_SUPERUSER_NAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin_password

# =============================================================================
# WEB CONFIGURATION
# =============================================================================

HOMEPAGE_URL="http://localhost:3000"
AUTH_ORIGIN="$HOMEPAGE_URL/api/auth"
