# =============================================================================
#  GLOBAL CONFIGURATION
# =============================================================================
GLOBAL_STACK_NAME=<string/staging>

# =============================================================================
# TRAEFIK / TLS (STAGING)
# =============================================================================
DOMAIN=<string/staging.example.com>
LETSENCRYPT_EMAIL=<string/devops@example.com>
LETSENCRYPT_CA_SERVER=<string/https://acme-staging-v02.api.letsencrypt.org/directory>
# Filesystem path mounted on swarm manager(s), provisioned via Ansible/Terraform
TRAEFIK_CERTS_PATH=<string//mnt/shared/traefik/staging>

GRAFANA_PASSWORD=<string/change_me>
TRAEFIK_EXPOSE_API=<bool/true>
TRAEFIK_USERNAME=<string/admin>
TRAEFIK_HASHED_PASSWORD=<string/$apr1$...>

# =============================================================================
# STAGING REPLICAS (STATELESS SERVICES)
# =============================================================================
STG_REPLICAS_FORMULA_PARSER=<int/2>
STG_REPLICAS_DDL_GENERATOR=<int/2>
STG_REPLICAS_SQL_BUILDER=<int/2>
STG_REPLICAS_EXCEL_READER=<int/2>
STG_REPLICAS_DATABASE=<int/2>
STG_REPLICAS_TYPECHECKING=<int/2>
STG_REPLICAS_API=<int/2>
STG_REPLICAS_WEB=<int/2>

# =============================================================================
# SCALER CONFIGURATION
# =============================================================================
SCALER_PROMETHEUS_URL=<string/http://prometheus:9090>
SCALER_CHECK_INTERVAL=<int/45>
SCALER_COOLDOWN_PERIOD=<int/120>
SCALER_METRIC_WINDOW_MULTIPLIER=<int/3>
SCALER_DEFAULT_MIN_REPLICAS=<int/1>
SCALER_DEFAULT_MAX_REPLICAS=<int/10>

# =============================================================================
# PARSERS CONFIGURATION
# =============================================================================

# ── Formula Parser ──
PARSERS_FORMULA_PARSER_HOST=<string/localhost>
PARSERS_FORMULA_PARSER_PORT=<int/50052>
PARSERS_DEBUG_FORMULA_PARSER=<bool/false>

# ── DDL Generator ──
PARSERS_DDL_GENERATOR_HOST=<string/localhost>
PARSERS_DDL_GENERATOR_PORT=<int/50053>
PARSERS_DDL_GENERATOR_DEBUG=<bool/false>

# ── SQL Builder ──
PARSERS_SQL_BUILDER_HOST=<string/localhost>
PARSERS_SQL_BUILDER_PORT=<int/50054>
PARSERS_SQL_BUILDER_DEBUG=<bool/false>

# ── Excel Reader ──
PARSERS_EXCEL_READER_HOST=<string/localhost>
PARSERS_EXCEL_READER_PORT=<int/8001>
PARSERS_EXCEL_READER_DEBUG=<bool/false>

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================
RABBITMQ_DEFAULT_USER=<string/user>
RABBITMQ_DEFAULT_PASS=<string/password>
RABBITMQ_DEFAULT_VHOST=<string/>

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
MONGO_INITDB_ROOT_USERNAME=<string/mongoadmin>
MONGO_INITDB_ROOT_PASSWORD=<string/mongopass>
MONGO_DB=<string/etl_db>
MONGO_SCHEMAS_COLLECTION=<string/schemas>
MONGO_TASKS_COLLECTION=<string/tasks>

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_DB=<int/0>
REDIS_PASSWORD=<string/redispass>

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
POSTGRES_USER=<string/postgres>
POSTGRES_PASSWORD=<string/postgres>
POSTGRES_DB=<string/postgres>

PGADMIN_DEFAULT_EMAIL=<string/admin@example.com>
PGADMIN_DEFAULT_PASSWORD=<string/change_here>

# =============================================================================
# DATABASE SERVICE CONFIGURATION
# =============================================================================

# ── MongoDB Settings ──
MONGO_MAX_RETRIES=<int/5>
MONGO_RETRY_DELAY_SECONDS=<float/0.5>
MONGO_RETRY_BACKOFF_FACTOR=<float/2.0>

# ── Redis Settings ──
REDIS_EXPIRE_SECONDS=<int/60 * 5>
REDIS_MAX_RETRIES=<int/5>
REDIS_RETRY_DELAY_SECONDS=<float/0.5>
REDIS_RETRY_BACKOFF_FACTOR=<float/2.0>

# ── Connection Settings ──
DATABASE_CONNECTION_HOST=<string/localhost>
DATABASE_CONNECTION_PORT=<int/50050>
DATABASE_CONNECTION_DEBUG=<bool/false>

# ── Task TTL Settings ──
TASK_TTL_PENDING_SECONDS=<int/60 * 30>
TASK_TTL_PROCESSING_SECONDS=<int/60 * 60>
TASK_TTL_COMPLETED_SECONDS=<int/60 * 60 * 24>
TASK_TTL_PUBLISHED_SECONDS=<int/60 * 60 * 12>
TASK_TTL_FAILED_SECONDS=<int/60 * 60 * 12>

# ── Cache TTL Settings ──
USER_CACHE_TTL_SECONDS=<int/60 * 15>
USER_LIST_CACHE_TTL_SECONDS=<int/60 * 5>
SCHEMA_CACHE_TTL_SECONDS=<int/60 * 60 * 6>
DEFAULT_TTL_SECONDS=<int/60 * 30>

# =============================================================================
# TYPECHECKING SERVICE CONFIGURATION
# =============================================================================

# ── Server Settings ──
TYPECHECKING_MINIMAL_SERVER_PORT=<int/8080>

# ── RabbitMQ Retry Settings ──
RABBITMQ_MAX_RETRIES=<int/5>
RABBITMQ_RETRY_DELAY_SECONDS=<float/1.0>
RABBITMQ_BACKOFF_MULTIPLIER=<float/2.0>
RABBITMQ_THRESHOLD_SECONDS=<float/60.0>

# ── Worker Settings ──
MAX_WORKERS=<int/4>
WORKER_PREFETCH_COUNT=<int/1>

# ── Database Retry Settings ──
DATABASE_MAX_RETRIES=<int/5>
DATABASE_RETRY_DELAY_SECONDS=<float/1.0>
DATABASE_BACKOFF_MULTIPLIER=<float/2.0>

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_V1_STR=<str/\/api/v1>
CORS_ORIGINS=<string[]/http://localhost,http://localhost:3000,http://localhost:8000>
SERVER_HOST=<string/localhost>
SERVER_PORT=<int/8000>
SERVER_DEBUG=<bool/false>
AUTH_SECRET=<string/your_secret_key_here>
AUTH_SIGN=<string/your_auth_sign_here>

CREDENTIALS_SECRET_KEY=<string/your_credentials_secret_key_here>
CREDENTIALS_SIGN=<string/your_credentials_sign_here>

IDEMPOTENCY_TTL_DEFAULT_SECONDS=<int/60 * 10>
IDEMPOTENCY_TTL_RETRY_DELAY_SECONDS=<int/60>
IDEMPOTENCY_TTL_PUBLISHED_SECONDS=<int/60 * 30>

FIRST_SUPERUSER_NAME=<string/admin>
FIRST_SUPERUSER_EMAIL=<string/admin@example.com>
FIRST_SUPERUSER_PASSWORD=<string/admin_password>

# =============================================================================
# WEB CONFIGURATION
# =============================================================================

HOMEPAGE_URL=<string/http://localhost:3000>
AUTH_ORIGIN=<string/"$HOMEPAGE_URL/api/auth">
